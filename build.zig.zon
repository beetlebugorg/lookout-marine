.{
    .name = .lookout_marine,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x40d25cc1551ceccf,
    .dependencies = .{
        // The tile57 chart engine, built from source inside this build. Both
        // entries are lazy and build.zig picks exactly one: `tile57_local`
        // when a sibling checkout exists at ../tile57 (dev setups — your
        // engine edits rebuild live), otherwise the pinned `tile57` git
        // dependency is fetched automatically, so a fresh clone of this repo
        // alone builds. Bump the commit + hash here to move the pin.
        .tile57 = .{
            .url = "git+https://github.com/beetlebugorg/tile57#edcac132a2dad7cbb0144947bac7d1a838e7ee57",
            .hash = "tile57-0.3.0-SAveCKovIAHJyCWwyAoY8vmdA_7LgbvEVpG9OK9nAmVH",
            .lazy = true,
        },
        .tile57_local = .{ .path = "../tile57", .lazy = true },
        // charttable draws the chart: it holds the style, the tile sources, the
        // tessellators and the GPU. Same local-or-pinned pair as tile57.
        .charttable = .{
            .url = "git+https://github.com/beetlebugorg/charttable#788d36a621eb29ef5891aa18fd9dc7042f6d0f2c",
            .hash = "charttable-0.0.0-dev-3P4mHmHUGAAVmuUPhB7AP6ATzG8rjDHMiSKxH_lCh4jn",
            .lazy = true,
        },
        .charttable_local = .{ .path = "../charttable", .lazy = true },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "shaders", "vendor", "include" },
}
