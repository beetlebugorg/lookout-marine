.{
    .name = .lookout_marine,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x40d25cc1551ceccf,
    .dependencies = .{
        // The tile57 chart engine, built from source inside this build. Both
        // entries are lazy and build.zig picks exactly one: `tile57_local`
        // when a sibling checkout exists at ../tile57 (dev setups — your
        // engine edits rebuild live), otherwise the pinned `tile57` git
        // dependency is fetched automatically, so a fresh clone of this repo
        // alone builds. Bump the commit + hash here to move the pin.
        .tile57 = .{
            .url = "git+https://github.com/beetlebugorg/tile57#20a2a98b6d8e83f3db2165da2c203f2cf38c246d",
            .hash = "tile57-0.3.0-SAveCJ1aGwE75j0--JeMKI9iA7qqZpFuy27vfkJEBuhd",
            .lazy = true,
        },
        .tile57_local = .{ .path = "../tile57", .lazy = true },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "shaders", "vendor", "include" },
}
