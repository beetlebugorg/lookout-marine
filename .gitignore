zig-out/
zig-out-*/
.zig-cache/
# Fetched zig packages, materialized per-project (tile57 + the S-101
# catalogue arrive here on machines without a sibling checkout).
zig-pkg/
*.png
# The documentation images are tracked. The pattern must match a nested path:
# "!docs/*.png" left docs/docs/img/*.png ignored.
!docs/**/*.png
# So is the app icon: the brand masters and every per-platform size generated
# from them. These are sources for the build, not build output — a clone
# without them cannot produce an app with an icon.
!assets/brand/*.png
!macos/LookoutMarine/Assets.xcassets/**/*.png
!macos/LookoutMarine-iOS/Assets.xcassets/**/*.png
!linux/data/icons/**/*.png
!android/app/src/main/res/mipmap-*/*.png
.DS_Store
# Xcode / xcodegen derived data — never tracked. build-mac holds every product
# (macOS and the iOS simulator alike); the glob also catches older trees.
macos/build*/
macos/DerivedData/
# One developer's window positions, breakpoints and last-run scheme. Opening
# the project writes these, so they appear whoever builds.
**/xcuserdata/
# Docusaurus build output
docs/build/
docs/.docusaurus/

# WAMR: the pinned clone and the archives scripts/build-wamr.sh produces —
# one dist per platform and architecture (macos, ios, iossim, linux-x64,
# linux-arm64, windows-x64, android-arm64).
# Source, not artifacts — rebuild with scripts/build-wamr.sh.
vendor/wamr/
vendor/wamr-dist*/
# Generated by tools/nmea_gen.zig for the plugin harness (the committed
# parser fixtures are a separate, much smaller file).
test/annapolis.nmea

# Local engineering notes (not version-controlled)
/specs/

# Claude Code agent worktrees / session data
.claude/
