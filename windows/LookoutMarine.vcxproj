<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- CppWinRT.props MUST be imported at the very top (before Cpp.Default.props):
       it sets XamlLanguage=CppWinRT and wires the WinUI markup passes + the
       XAML-generated .cpp into the native build. PackageReference auto-imports
       the .targets but NOT this .props, so import it explicitly from the global
       package cache. Without it the markup stubs/impls never compile. -->
  <Import Project="$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props')" />

  <!-- x64 as well as ARM64. The README has told people to pass /p:Platform=x64
       on an x64 machine since this project was written, and without the pair
       below msbuild refuses the switch. It is also the only Windows platform
       the wasm plugin host can be built for: scripts/build-wamr.sh fills
       vendor/wamr-dist-windows-x64 and has no ARM64 Windows slot at all, so an
       ARM64 build is a chartplotter with no own ship and no AIS. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTUsePrefixes>true</CppWinRTUsePrefixes>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{A6E3C1B2-0D4F-4A21-9C7E-9A1F2B3C4D5E}</ProjectGuid>
    <ProjectName>LookoutMarine</ProjectName>
    <RootNamespace>LookoutMarine</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <AppContainerApplication>false</AppContainerApplication>
    <!-- 2.x WindowsAppSDK is a meta-package with transitive deps; PackageReference
         pulls them all (packages.config can't). -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <GenerateManifest>true</GenerateManifest>
    <!-- The chart core + tile57, built by windows\build-core.ps1 into ..\zig-out. -->
    <LookoutCoreLibDir>$(MSBuildThisFileDirectory)..\zig-out\lib</LookoutCoreLibDir>
    <LookoutCoreIncDir>$(MSBuildThisFileDirectory)..\zig-out\include</LookoutCoreIncDir>
    <!-- The shipped wasm plugin set, written by `zig build plugins` (which
         build-core.ps1 runs). It holds the org.beetlebug pairs and nothing
         else, so the whole directory is what travels with the exe. -->
    <LookoutBundledPluginDir>$(MSBuildThisFileDirectory)..\zig-out\plugins-bundled</LookoutBundledPluginDir>

    <!-- The source tree, by area. Each directory holds a part of the app and
         the model that drives it — the pick report card sits with the pick
         decoder, the raster pill with the raster paths — so a change to one
         feature is a change in one place. See README.md. -->
    <LkSrc>$(MSBuildThisFileDirectory)src</LkSrc>
    <LkSourceDirs>$(LkSrc)\app;$(LkSrc)\chart;$(LkSrc)\hud;$(LkSrc)\library;$(LkSrc)\plugins;$(LkSrc)\settings;$(LkSrc)\about;$(LkSrc)\engine;$(LkSrc)\util</LkSourceDirs>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- Every source directory is on the include path, so a header is
           included by name and moving one between areas costs nothing.
           $(IntDir)(+src\app): the WinUI markup passes write <Name>.xaml.g.h
           there, MIRRORING THE SOURCE LAYOUT — so this pair moves with the
           .xaml. The project root carries pch.h. -->
      <AdditionalIncludeDirectories>$(IntDir);$(IntDir)src\app;$(MSBuildThisFileDirectory);$(LkSourceDirs);$(LookoutCoreIncDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- What About and the licenses screen report this build as. Kept in
           step with build.zig.zon's version, the way linux/meson.build passes
           its own project version through as LK_VERSION. -->
      <PreprocessorDefinitions>LK_VERSION=0.1.0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <!-- Sources are UTF-8; without this MSVC reads the wide literals (…, °, ×) as ANSI. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(LookoutCoreLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- user32: LoadImageW/SendMessageW/GetSystemMetrics, for the window icon
           (MinimalCoreWin trims the default link libraries, so the Win32 ones
           this shell uses are all named explicitly). -->
      <AdditionalDependencies>lookout_marine.lib;tile57.lib;ntdll.lib;gdi32.lib;shell32.lib;user32.lib;winmm.lib;dnsapi.lib;CoreMessaging.lib;d3d12.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- The WAMR interpreter, when build-core.ps1 built a core with the plugin
           host in it. The static core does not embed the archive off Apple (a
           COFF linker rejects an archive nested inside an archive), so the exe
           links the pair; it is named AFTER lookout_marine.lib above, which is
           what resolves the wasm symbols the core calls. Conditioned on the
           file so an ARM64 build, which has no archive to link, still links. -->
      <AdditionalDependencies Condition="Exists('$(LookoutCoreLibDir)\vmlib.lib')">vmlib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="resource.h" />
    <!-- DependentUpon links the code-behind to its .xaml so the WinUI markup
         compiler emits the per-page <name>.xaml.g.h stub (InitializeComponent). -->
    <ClInclude Include="src\app\App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="src\app\MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>

  <!-- One group per area of the app, in the order the shell reaches for them.
       Each holds the WinUI that draws that area and the model that drives it;
       a model file carries NotUsing, because it must build without the PCH and
       therefore without WinRT — that is what lets build-tests.ps1 link it into
       a test binary with no XAML host. Keep it that way: a winrt include in
       one of those files takes the tests with it. -->

  <!-- app: the two XAML types, the window shell, the menu. -->
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\app\App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="src\app\MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="src\app\Menu.cpp" />
    <ClCompile Include="src\app\winrt_glue.cpp" />
  </ItemGroup>

  <!-- chart: the chart surface, its gestures, and the pick report. -->
  <ItemGroup>
    <ClCompile Include="src\chart\Open.cpp" />
    <ClCompile Include="src\chart\Input.cpp" />
    <ClCompile Include="src\chart\Markers.cpp" />
    <ClCompile Include="src\chart\Pick.cpp" />
    <ClCompile Include="src\chart\PickAux.cpp" />
    <ClCompile Include="src\chart\lk_pick.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- hud: the readouts, the scale, the loader, the overlay bubbles. -->
  <ItemGroup>
    <ClCompile Include="src\hud\Hud.cpp" />
    <ClCompile Include="src\hud\Loader.cpp" />
    <ClCompile Include="src\hud\Overlay.cpp" />
    <ClCompile Include="src\hud\Scale.cpp" />
    <ClCompile Include="src\hud\lk_format.cpp" />
  </ItemGroup>

  <!-- library: the charts aboard — sets, raster, the bake, charts by link. -->
  <ItemGroup>
    <ClCompile Include="src\library\ChartSets.cpp" />
    <ClCompile Include="src\library\ChartLinks.cpp" />
    <ClCompile Include="src\library\Raster.cpp" />
    <ClCompile Include="src\library\Bake.cpp" />
    <ClCompile Include="src\library\lk_paths.cpp" />
    <ClCompile Include="src\library\lk_bake.cpp" />
  </ItemGroup>

  <!-- plugins: their settings, their tables, their alerts, their install. -->
  <ItemGroup>
    <ClCompile Include="src\plugins\PluginSettings.cpp" />
    <ClCompile Include="src\plugins\PluginInstall.cpp" />
    <ClCompile Include="src\plugins\Tables.cpp" />
    <ClCompile Include="src\plugins\Alerts.cpp" />
    <ClCompile Include="src\plugins\lk_discovery.cpp" />
    <ClCompile Include="src\plugins\lk_plugin_registry.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\plugins\lk_alerts.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\plugins\lk_table.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- settings: the mariner settings window. -->
  <ItemGroup>
    <ClCompile Include="src\settings\Settings.cpp" />
  </ItemGroup>

  <!-- about: About and the licences. -->
  <ItemGroup>
    <ClCompile Include="src\about\Licenses.cpp" />
    <ClCompile Include="src\about\lk_licenses_baked.cpp" />
    <ClCompile Include="src\about\lk_licenses.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- engine: the seams — the Zig core, the disk, the compositor. Plain C
       where it is a port of the Linux shell's own. -->
  <ItemGroup>
    <ClCompile Include="src\engine\lk_backdrop.cpp" />
    <ClCompile Include="src\engine\lk_controller.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\engine\lk_store.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- util: what every area uses and none of them owns. -->
  <ItemGroup>
    <ClCompile Include="src\util\lk_json.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\util\lk_utf8.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\util\lk_coord.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <Midl Include="src\app\App.idl" />
    <Midl Include="src\app\MainWindow.idl" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\app\App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="src\app\MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <!-- The app icon. Unpackaged, so it is a linked-in ICON resource rather than
       a Package.appxmanifest Logo; LookoutMarine.ico sits next to the .rc and
       rc.exe resolves it relative to the script. -->
  <ItemGroup>
    <ResourceCompile Include="LookoutMarine.rc" />
    <None Include="LookoutMarine.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260715.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Command-line native builds don't auto-run the WinUI XAML markup passes.
       Force them right before ClCompile (references are resolved by this point,
       so no WMC1007) to generate <Name>.xaml.g.h (decls) and <Name>.xaml.g.hpp
       (InitializeComponent/WinMain impls, #included by the code-behind). -->
  <Target Name="LkGenerateXamlMarkup"
          BeforeTargets="ClCompile"
          DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2"
          Condition="'@(Page)@(ApplicationDefinition)' != ''" />

  <!-- The core plugins travel beside the exe, in $(OutDir)plugins. Own ship,
       AIS, NMEA 0183, Signal K and laylines are all wasm plugins, so a build
       that ships none is a chartplotter with no boat and no traffic.

       Skipped when the directory is absent (a tree where build-core.ps1 has
       not run) rather than failing the build: the shell starts without
       plugins, it does not fail to link. -->
  <Target Name="LkCopyBundledPlugins"
          AfterTargets="Build"
          Condition="Exists('$(LookoutBundledPluginDir)')">
    <ItemGroup>
      <LkBundledPlugin Include="$(LookoutBundledPluginDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LkBundledPlugin)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="bundled plugins: @(LkBundledPlugin->Count()) file(s) -> $(OutDir)plugins" />
  </Target>
</Project>
