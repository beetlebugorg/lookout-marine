<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- CppWinRT.props MUST be imported at the very top (before Cpp.Default.props):
       it sets XamlLanguage=CppWinRT and wires the WinUI markup passes + the
       XAML-generated .cpp into the native build. PackageReference auto-imports
       the .targets but NOT this .props, so import it explicitly from the global
       package cache. Without it the markup stubs/impls never compile. -->
  <Import Project="$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props')" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTUsePrefixes>true</CppWinRTUsePrefixes>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{A6E3C1B2-0D4F-4A21-9C7E-9A1F2B3C4D5E}</ProjectGuid>
    <ProjectName>LookoutMarine</ProjectName>
    <RootNamespace>LookoutMarine</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <AppContainerApplication>false</AppContainerApplication>
    <!-- 2.x WindowsAppSDK is a meta-package with transitive deps; PackageReference
         pulls them all (packages.config can't). -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <GenerateManifest>true</GenerateManifest>
    <!-- The chart core + tile57 + Vulkan loader, built by windows\build-core.ps1
         into ..\zig-out. -->
    <LookoutCoreLibDir>$(MSBuildThisFileDirectory)..\zig-out\lib</LookoutCoreLibDir>
    <LookoutCoreIncDir>$(MSBuildThisFileDirectory)..\zig-out\include</LookoutCoreIncDir>
    <VulkanSdkDir Condition="'$(VULKAN_SDK)' != ''">$(VULKAN_SDK)</VulkanSdkDir>
    <VulkanSdkDir Condition="'$(VULKAN_SDK)' == ''">C:\VulkanSDK\1.4.350.0</VulkanSdkDir>
    <!-- x86 keeps its import libs in Lib32; x64/ARM64 in Lib. (x86 is a planned
         target; the core must also be rebuilt for that arch — see build-core.ps1.) -->
    <VulkanLibSubdir Condition="'$(Platform)'=='Win32'">Lib32</VulkanLibSubdir>
    <VulkanLibSubdir Condition="'$(Platform)'!='Win32'">Lib</VulkanLibSubdir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- $(IntDir): the WinUI markup passes write <Name>.xaml.g.h there. -->
      <AdditionalIncludeDirectories>$(IntDir);$(MSBuildThisFileDirectory)src;$(LookoutCoreIncDir);$(VulkanSdkDir)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level3</WarningLevel>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <!-- Sources are UTF-8; without this MSVC reads the wide literals (…, °, ×) as ANSI. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(LookoutCoreLibDir);$(VulkanSdkDir)\$(VulkanLibSubdir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>lookout_marine.lib;tile57.lib;vulkan-1.lib;ntdll.lib;gdi32.lib;shell32.lib;CoreMessaging.lib;d3d12.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <!-- DependentUpon links the code-behind to its .xaml so the WinUI markup
         compiler emits the per-page <name>.xaml.g.h stub (InitializeComponent). -->
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.Open.cpp" />
    <ClCompile Include="MainWindow.ChartHost.cpp" />
    <ClCompile Include="MainWindow.Input.cpp" />
    <ClCompile Include="MainWindow.Hud.cpp" />
    <ClCompile Include="MainWindow.Settings.cpp" />
    <ClCompile Include="src\lk_paths.cpp" />
    <ClCompile Include="src\lk_format.cpp" />
    <ClCompile Include="src\lk_backdrop.cpp" />
    <ClCompile Include="winrt_glue.cpp" />
    <!-- The host-agnostic C layer (ports of the Linux shell's controller/store/
         coord) — plain C, no PCH. -->
    <ClCompile Include="src\lk_controller.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\lk_store.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\lk_coord.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\lk_d3d.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <Midl Include="App.idl" />
    <Midl Include="MainWindow.idl" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260715.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Command-line native builds don't auto-run the WinUI XAML markup passes.
       Force them right before ClCompile (references are resolved by this point,
       so no WMC1007) to generate <Name>.xaml.g.h (decls) and <Name>.xaml.g.hpp
       (InitializeComponent/WinMain impls, #included by the code-behind). -->
  <Target Name="LkGenerateXamlMarkup"
          BeforeTargets="ClCompile"
          DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2"
          Condition="'@(Page)@(ApplicationDefinition)' != ''" />
</Project>
