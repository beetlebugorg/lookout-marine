<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookoutMarine.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- The chart presents into a native child HWND below the XAML bridge. The
         bridge window is clipped to the chrome rects, so the chart shows and
         gets input everywhere else. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="Bubble" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#1A1A1A" />
            </Style>
        </Grid.Resources>

        <!-- DXGI mode inserts a SwapChainPanel here at index 0 in code. A panel
             in markup would exist in BOTH modes, and even an empty panel is
             external content that blanks the window over the fallback chart. -->

        <!-- top-left: search, and the menu under it.
             The commands live in a bubble rather than a menu bar, because the
             chart is the app: a bar would take a strip of water on every
             screen, and this is the one shape the Mac, the iPad and the phone
             can all wear. The list is built in code (MainWindow.Menu.cpp),
             since most of it names things that come and go: the charts opened
             lately, the raster sets covering this view, the tables the plugins
             declare. -->
        <StackPanel x:Name="SearchCluster" Spacing="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SearchBtn" Style="{StaticResource Bubble}">
                    <FontIcon x:Name="SearchIcon" Glyph="&#xE721;" FontSize="18" />
                </Button>
                <TextBox x:Name="SearchBox" Width="320" Height="48" CornerRadius="24"
                         VerticalAlignment="Center" Visibility="Collapsed"
                         PlaceholderText="Go to coordinate  (e.g. 38.978, -76.492)" />
            </StackPanel>
            <Button x:Name="MenuBtn" Style="{StaticResource Bubble}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Menu">
                <FontIcon Glyph="&#xE700;" FontSize="18" />
            </Button>
        </StackPanel>

        <!-- top-right: north -->
        <Button x:Name="NorthBtn" Style="{StaticResource Bubble}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <RotateTransform x:Name="NorthRotate" />
                </StackPanel.RenderTransform>
                <FontIcon x:Name="NorthCaret" Glyph="&#xEDDB;" FontSize="9" HorizontalAlignment="Center" />
                <TextBlock x:Name="NorthLetter" Text="N" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,-1,0,0" />
            </StackPanel>
        </Button>

        <!-- bottom-right: zoom above layers + settings -->
        <StackPanel x:Name="ZoomStack" Orientation="Vertical" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,74">
            <Button x:Name="ZoomInBtn" Style="{StaticResource Bubble}">
                <FontIcon Glyph="&#xE710;" FontSize="18" />
            </Button>
            <Button x:Name="ZoomOutBtn" Style="{StaticResource Bubble}">
                <FontIcon Glyph="&#xE738;" FontSize="18" />
            </Button>
        </StackPanel>
        <!-- Chart opening lives in the empty state, Ctrl+O, and Settings ▸
             Charts — the chart chrome carries no open button, matching the
             macOS and Android shells. -->
        <Button x:Name="SettingsBtn" Style="{StaticResource Bubble}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
            <FontIcon Glyph="&#xE713;" FontSize="18" />
        </Button>

        <!-- bottom-left: scale bar -->
        <StackPanel x:Name="ScaleBar" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="16,0,0,16" Spacing="3">
            <TextBlock x:Name="ScaleBarLabel" FontSize="12" FontWeight="SemiBold" Text="" />
            <StackPanel x:Name="ScaleBarSegs" Orientation="Horizontal" Height="6" />
        </StackPanel>

        <!-- top-center: the plugin alert strip above the build pill, so an
             alarm is never under it. Alert rows are built in code
             (MainWindow.Alerts.cpp); only unacknowledged alerts show, two at
             most, the rest as one "n more" line. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,10,0,0" Spacing="8">
            <Border x:Name="AlertStrip" MaxWidth="560" CornerRadius="8"
                    Background="#F8F8F8" BorderBrush="#33000000" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel x:Name="AlertRows" />
            </Border>
            <Border x:Name="BuildingPill" CornerRadius="14" Padding="12,6"
                    Background="#E6F8F8F8" BorderBrush="#33000000" BorderThickness="1"
                    HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="Building chart…" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- pick marker: a white ring under an S-52 magenta ring, so the mark
             stays visible on a night chart. Placed in code at the pick point. -->
        <Grid x:Name="PickMarker" Width="34" Height="34" Visibility="Collapsed"
              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse Stroke="#D9FFFFFF" StrokeThickness="4" Margin="3" />
            <Ellipse Stroke="#DB198C" StrokeThickness="2" Margin="3" />
        </Grid>

        <!-- pick report card: a callout placed beside the mark in code. The
             list column shows only when the pick found more than one object;
             every dynamic row is built in MainWindow.Pick.cpp. -->
        <Border x:Name="PickCard" CornerRadius="12" Background="White"
                BorderBrush="#33000000" BorderThickness="1" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="PickListPane" Width="200" Background="#80F0F0F0"
                      Visibility="Collapsed" CornerRadius="12,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PickListHeader" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="80" Foreground="#6B6B6B"
                               Margin="14,12,14,6" Text="OBJECTS" />
                    <ScrollViewer x:Name="PickListScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PickList" Margin="6,0,6,8" Spacing="2" />
                    </ScrollViewer>
                    <!-- the chart's notes (meta objects) pinned at the column's
                         floor: they keep one place and never scroll away -->
                    <Border x:Name="PickNotesShelfRule" Grid.Row="2" BorderBrush="#DDDDDD"
                            BorderThickness="0,1,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="PickNotesShelf" Margin="6,6,6,8" Spacing="2" />
                    </Border>
                </Grid>
                <Rectangle x:Name="PickListRule" Grid.Column="0" Width="1" Fill="#DDDDDD"
                           HorizontalAlignment="Right" Visibility="Collapsed" />
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,8,8" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PickTitle" FontSize="19" FontWeight="Bold"
                                       Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"
                                       MaxLines="1" Text="" />
                            <!-- reserved even when empty: the header keeps one
                                 height for every object so rows never shift -->
                            <TextBlock x:Name="PickSubtitle" FontSize="13" Foreground="#6B6B6B"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Text=" " />
                        </StackPanel>
                        <Button x:Name="PickCopyBtn" Grid.Column="1" Padding="8"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Top" AutomationProperties.Name="Copy this report">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                        <Button x:Name="PickCloseBtn" Grid.Column="2" Padding="8"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Top" AutomationProperties.Name="Close the pick report">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="1" Height="1" Fill="#DDDDDD" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PickBody" Margin="0,8,0,8" Spacing="0" />
                    </ScrollViewer>
                    <Rectangle Grid.Row="3" Height="1" Fill="#DDDDDD" />
                    <TextBlock x:Name="PickFootnote" Grid.Row="4" FontSize="11"
                               Foreground="#6B6B6B" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Margin="16,6,16,4" Text="" />
                    <Button x:Name="PickFoldBtn" Grid.Row="5" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="14,6,14,8"
                            Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PickFoldIcon" Glyph="&#xE76C;" FontSize="10"
                                      Foreground="#6B6B6B" />
                            <TextBlock x:Name="PickFoldLabel" FontSize="12" Foreground="#6B6B6B"
                                       Text="S-57 source attributes" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- empty state -->
        <Border x:Name="EmptyState" CornerRadius="12" Padding="24"
                Background="#F2F8F8F8" BorderBrush="#33000000" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="No chart open" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Open a baked chart (.pmtiles) or a folder of cells."
                           FontSize="13" Opacity="0.7" HorizontalAlignment="Center" />
                <Button x:Name="EmptyOpenBtn" Content="Open Charts…" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- The mariner settings, in the shape every shell wears: a list of
             sections down the left, the section itself on the right, and the
             one promise the whole thing makes standing under the list rather
             than repeated in every section.
             This lives in ITS OWN WINDOW (MainWindow.Settings.cpp moves it
             there at construction). A pane over the chart had to dodge the
             HUD and the corner bubbles, which left it too narrow for a
             two-column form and put it under the chrome it was covering. -->
        <Border x:Name="SettingsPane" Background="#FFF8F8F8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- section rows are added in code: the set moves
                             when a plugin brings a section with it -->
                        <StackPanel x:Name="SettingsTabs" Margin="8,12,8,0" Spacing="2" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="Applies at once · kept for next launch"
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Margin="14,8,10,12" />
                </Grid>
                <Rectangle Grid.Column="1" Width="1" Fill="#DDDDDD"
                           HorizontalAlignment="Left" />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Padding="20,12,20,16">
                    <!-- rows are added in code per section -->
                    <StackPanel x:Name="SettingsContent" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- bottom-center: the zoom-to-scale panel, above the readout capsule.
             Presets are built in code (MainWindow.Scale.cpp). -->
        <Border x:Name="ScalePanel" Width="340" CornerRadius="12" Background="White"
                BorderBrush="#33000000" BorderThickness="1" Padding="14"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,70" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Zoom to scale" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" />
                        <TextBlock x:Name="ScaleNow" FontSize="12" Foreground="#6B6B6B"
                                   VerticalAlignment="Center" Text="" />
                    </StackPanel>
                    <Button x:Name="ScaleClose" HorizontalAlignment="Right" Padding="4"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="1:" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1A1A1A" VerticalAlignment="Center" />
                    <TextBox x:Name="ScaleBox" Grid.Column="1" FontSize="17"
                             FontWeight="SemiBold" PlaceholderText="25,000" />
                    <Button x:Name="ScaleGo" Grid.Column="2" Content="Go" IsEnabled="False"
                            VerticalAlignment="Stretch" />
                </Grid>
                <TextBlock x:Name="ScaleHint" FontSize="12" Foreground="#6B6B6B"
                           TextWrapping="Wrap" Text="Type a scale, for example 25,000 or 1:25k." />
                <StackPanel x:Name="ScalePresetRows" Spacing="6" />
            </StackPanel>
        </Border>

        <!-- bottom-center: readout capsule -->
        <Border x:Name="HudPill" Height="44" CornerRadius="22" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,16" Padding="18,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
                <TextBlock x:Name="HudBand" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1A1A1A" VerticalAlignment="Center" Text="—" />
                <Rectangle Width="1" Height="20" Fill="#DDDDDD" />
                <!-- the one control in the capsule: click to zoom to a scale -->
                <Button x:Name="HudScaleBtn" Padding="4,2" Background="Transparent"
                        BorderThickness="0" CornerRadius="6" VerticalAlignment="Center"
                        AutomationProperties.Name="Zoom to a scale">
                    <TextBlock x:Name="HudScale" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1B49C4" Text="1:—" />
                </Button>
                <Rectangle Width="1" Height="20" Fill="#DDDDDD" />
                <TextBlock x:Name="HudZoom" FontSize="14" Foreground="#6B6B6B"
                           VerticalAlignment="Center" Text="z—" />
                <Rectangle Width="1" Height="20" Fill="#DDDDDD" />
                <!-- position source, beside the position it qualifies: GPS
                     while a plugin publishes a fix, NO GPS when the fix is
                     lost, Configure GPS when there is no source at all. A
                     button in every state: it opens Settings at Connections. -->
                <Button x:Name="GpsPill" Padding="7,2" BorderThickness="0"
                        CornerRadius="8" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Position source">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon x:Name="GpsIcon" Glyph="&#xE707;" FontSize="11" />
                        <TextBlock x:Name="GpsText" FontSize="12" FontWeight="Bold" Text="GPS" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="HudCoord" FontSize="14" Foreground="#1A1A1A"
                           VerticalAlignment="Center" Text="—" />
                <Border x:Name="HudOverscale" CornerRadius="8" Padding="6,2"
                        Background="#33D83B01" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HudOverscaleText" FontSize="12" Text="×1.0" />
                </Border>
                <!-- the raster pill: shown while a raster chart set covers the
                     view — amber when it is switched off, blue while it is
                     drawn. The chevron is a promise: a press opens a list
                     (MainWindow.Raster.cpp). -->
                <Rectangle x:Name="RasterPillSep" Width="1" Height="20" Fill="#DDDDDD"
                           Visibility="Collapsed" />
                <Button x:Name="RasterPill" Padding="7,2" BorderThickness="0"
                        CornerRadius="8" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Choose a raster chart">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock x:Name="RasterPillText" FontSize="12" FontWeight="Bold" Text="" />
                        <FontIcon x:Name="RasterPillChevron" Glyph="&#xE70D;" FontSize="8" Opacity="0.7" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- startup loader: the S-52 NODATA day blue under a 22% scrim, so
             launch, loader and first frame read as one continuous surface.
             Three phases (baking atlas / mapping cells / tessellating) set in
             MainWindow.Loader.cpp. -->
        <Grid x:Name="StartupLoader" Background="#FF93AEBB" Visibility="Collapsed">
            <Grid Background="#38000000" />
            <Border CornerRadius="12" Background="#F2F8F8F8" BorderBrush="#33000000"
                    BorderThickness="1" Padding="28,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <!-- a hand-drawn compass mark: ring, four ticks, red north needle -->
                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                        <Ellipse Stroke="#1A1A1A" StrokeThickness="2.5" />
                        <Rectangle Width="2.5" Height="6" Fill="#1A1A1A"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <Rectangle Width="2.5" Height="6" Fill="#1A1A1A"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        <Rectangle Width="6" Height="2.5" Fill="#1A1A1A"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Rectangle Width="6" Height="2.5" Fill="#1A1A1A"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Polygon Points="28,13 23,31 33,31" Fill="#D42E2E" />
                    </Grid>
                    <TextBlock Text="Lookout Marine" FontSize="20" FontWeight="SemiBold"
                               Foreground="#1A1A1A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoaderPhase" FontSize="13" FontWeight="Medium"
                               Foreground="#1A1A1A" HorizontalAlignment="Center" Text="" />
                    <ProgressBar Width="240" IsIndeterminate="True" />
                    <TextBlock x:Name="LoaderNote" FontSize="12" Foreground="#6B6B6B"
                               HorizontalAlignment="Center" Visibility="Collapsed" Text="" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- chart import: raw S-57 cells being baked into charts the app can
             draw. Same surface as the startup loader, but the count is known,
             so the bar is determinate and the mariner can stop. Driven on a
             timer from the job's snapshot in MainWindow.Bake.cpp. -->
        <Grid x:Name="BakePanel" Background="#FF93AEBB" Visibility="Collapsed">
            <Grid Background="#38000000" />
            <Border CornerRadius="12" Background="#F2F8F8F8" BorderBrush="#33000000"
                    BorderThickness="1" Padding="28,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MinWidth="320">
                    <TextBlock x:Name="BakeTitle" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A1A1A" HorizontalAlignment="Center" Text="" />
                    <ProgressBar x:Name="BakeBar" Width="300" Minimum="0" Maximum="1"
                                 IsIndeterminate="True" />
                    <TextBlock x:Name="BakeCount" FontSize="13" Foreground="#1A1A1A"
                               HorizontalAlignment="Center" Text="" />
                    <TextBlock x:Name="BakeEta" FontSize="12" Foreground="#6B6B6B"
                               HorizontalAlignment="Center" Text="" />
                    <Button x:Name="BakeCancel" Content="Cancel" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- a bubble pinned to an overlay object (an AIS target): placed and
             refreshed per tick in MainWindow.Overlay.cpp, closed when the
             object goes. The hover tip is its one-shot cousin under the
             pointer. -->
        <Border x:Name="OverlayBubble" CornerRadius="10" Background="White"
                BorderBrush="#33000000" BorderThickness="1" Padding="12,8"
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel x:Name="OverlayBubbleBody" Spacing="2" />
        </Border>
        <Border x:Name="HoverTip" CornerRadius="8" Background="#F2FFFFFF"
                BorderBrush="#33000000" BorderThickness="1" Padding="10,6"
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False">
            <StackPanel x:Name="HoverTipBody" Spacing="1" />
        </Border>

        <!-- full-size picture viewer for a PICREP image; tap anywhere closes -->
        <Grid x:Name="PictureViewer" Background="#8C000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Border CornerRadius="10">
                    <Image x:Name="PictureImage" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="PictureName" FontSize="12" Foreground="#D9FFFFFF"
                           HorizontalAlignment="Center" Text="" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
