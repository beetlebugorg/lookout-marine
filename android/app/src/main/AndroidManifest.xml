<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- The chart renders via Vulkan (gpu_vk.zig); 1.0 is API 24's floor. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Charts are opened WHERE THEY LIE, by path: tile57 mmaps each cell and finds
      the bake's partition.tpart by walking parent directories, so it needs real
      filesystem paths. A SAF tree (content:// URI) has neither a path nor a
      parent walk, and copying a library in to get one would duplicate gigabytes
      of chart data on the device — so this asks for broad read access instead.
      Not acceptable for a Play release; this build is sideloaded.
      On API <= 29 the legacy read permission does the same job.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!--
      The instrument network. A source plugin (NMEA 0183, Signal K) opens a TCP
      client to the boat's gateway; that is the whole of what the app talks to,
      and the mariner names the address themselves in settings. INTERNET is a
      normal permission — granted at install, no runtime prompt — and without it
      bionic's connect() answers EACCES and every source plugin sits retrying.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Keeping the boat's instruments feeding while the app is not on screen. A
      chartplotter has to warn of a pending collision whether or not the mariner
      is looking at it, and a merely backgrounded app is throttled, frozen and
      reclaimed, so the work is declared instead.

      The type is connectedDevice, which the platform defines as an interaction
      with an external device over "Bluetooth, NFC, IR, USB, or network
      connection": this app holds a TCP session to the boat's gateway and reads
      NMEA from it. It is also the only honest type that is NOT time-limited.
      dataSync looks obvious and is capped at six hours in any twenty-four from
      Android 15, which on a passage means the alarms stop somewhere off the
      coast. location becomes true alongside once the app reads the device's own
      GPS; today position arrives over the same TCP session, so declaring it now
      would claim something the app does not do.

      CHANGE_NETWORK_STATE is connectedDevice's runtime prerequisite, not a
      wish: the platform requires one of CHANGE_NETWORK_STATE, CHANGE_WIFI_STATE,
      CHANGE_WIFI_MULTICAST_STATE, NFC or TRANSMIT_IR, or a granted Bluetooth or
      UWB permission, or a USB permission request. A device reached over the
      network has only the first group to choose from.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- API 33+: without it the service still runs but its notification is
         suppressed, and a mariner cannot see or stop what is holding the
         process up. Asked for at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The launcher icon resolves to mipmap-anydpi-v26/ic_launcher.xml (the
         adaptive icon) on API 26 and up, and to the per-density
         mipmap-*/ic_launcher.png on API 24-25. -->
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true" >
        <!-- Cleartext stays on: a boat's chart and data services live on the
             vessel LAN (a Pi serving tiles, a Signal K gateway) where http is
             the norm and no certificate authority reaches. -->


        <activity android:name="org.beetlebug.lookout.LookoutActivity"
            android:label="@string/app_name"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Files opened from another app: a .lkplug goes to the install
                 consent sheet, anything else is offered to the plugins
                 (lookout_open_file). File managers stamp unknown extensions
                 application/octet-stream or zip, so those are the types a
                 .lkplug arrives under; the NAME decides the route in code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/zip" />
                <data android:scheme="content" android:mimeType="application/gpx+xml" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/zip" />
                <data android:scheme="file" android:mimeType="application/gpx+xml" />
            </intent-filter>
        </activity>

        <!-- Started and stopped from what the connection rows say, never from
             an alarm: the thing that detects a collision is the thing that
             would otherwise not be running. See ChartService. -->
        <service
            android:name="org.beetlebug.lookout.engine.ChartService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
    </application>

</manifest>
