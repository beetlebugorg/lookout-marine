<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lookout Marine</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The app icon, from Assets.xcassets/AppIcon.appiconset. This plist is
	     hand-written (GENERATE_INFOPLIST_FILE is NO), so the key actool would
	     otherwise inject has to be named here. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- No storyboard. The launch screen is a flat fill in the NODATA blue of
	     the chart (Assets.xcassets/LaunchBackground). The Metal layer clears to
	     that color and StartupLoader paints it. The launch screen, the loader
	     and the first frame are therefore one surface. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- UIKit scene lifecycle with our SceneDelegate (it builds the chart /
	     input / chrome window stack — see LookoutMarineApp.swift). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- Charts arrive as files: expose Documents in Files.app + Finder sharing
	     so users can drop .pmtiles cells straight into the app (AppModel scans
	     Documents at startup). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- UIKit asks for this for full pointer/trackpad support (iPad, simulator). -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Let the chart's CADisplayLink run above 60Hz on ProMotion phones (the
	     link asks for 60-120; without this key iPhones clamp to 60 and the
	     adaptive governor is quicker to downshift). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Finding a source on the boat's network. NSBonjourServices is the
	     whole list this app may browse for: a plugin that declares a service
	     type not named here is not discoverable until the app ships it.
	     See specs/discovery.md. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lookout Marine looks for Signal K servers and NMEA gateways on your boat's network so you can add one without typing its address.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_signalk-ws._tcp</string>
		<string>_nmea-0183._tcp</string>
	</array>
</dict>
</plist>
